# ===== DATABASE CONFIGURATION =====
# SQLite (Development)
DATABASE_URL=sqlite:///data/incentive_system.db

# PostgreSQL (Production - uncomment to use)
# DATABASE_URL=postgresql://username:password@localhost:5432/incentive_system
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=incentive_system
# DB_USER=postgres
# DB_PASSWORD=your_secure_password

# ===== API CONFIGURATION =====
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_PORT=3000
API_TIMEOUT=30000
API_RESPONSE_LIMIT=50mb

# ===== ENVIRONMENT & RUNTIME =====
NODE_ENV=development
PYTHON_PATH=/usr/bin/python3
PYTHON_VERSION=3.9

# ===== AUTHENTICATION & SECURITY =====
JWT_SECRET=your_jwt_secret_key_here_change_in_production
API_KEY=your_api_key_here_change_in_production
SECRET_KEY=your_secret_key_here_change_in_production
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=localhost:3000,127.0.0.1:3000

# ===== FEATURE FLAGS =====
ENABLE_ANALYTICS=true
ENABLE_EXPORT=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_DATA_VALIDATION=true
ENABLE_CACHING=true
ENABLE_COMPRESSION=true

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=debug
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true
LOG_FILE_PATH=./logs/app.log
MAX_LOG_SIZE=10mb
MAX_LOG_FILES=10

# ===== PERFORMANCE & CACHING =====
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
DATABASE_POOL_SIZE=5
DATABASE_POOL_RECYCLE=3600

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_WHITELIST=localhost

# ===== DATA PROCESSING =====
DEFAULT_DATASET_SIZE=750
MAX_DATASET_SIZE=10000
ANOMOLY_THRESHOLD=3.0
ANOMOLY_PERCENTAGE=3
BATCH_SIZE=100

# ===== EMAIL CONFIGURATION (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@incentive-system.com
EMAIL_NOTIFICATIONS_ENABLED=false

# ===== EXTERNAL SERVICES =====
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ===== SENTRY (ERROR TRACKING) =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ===== DATADOG (MONITORING) =====
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_ENVIRONMENT=development

# ===== DEVELOPMENT OPTIONS =====
DEBUG_MODE=true
HOT_RELOAD=true
STRICT_MODE=false
EXPOSE_ERROR_DETAILS=true
